class Solution {
    public String dayOfTheWeek(int day, int month, int year) {

        String[] week = {
            "Sunday",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
        };

        int[] daysInMonth = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        int totalDays = 0;

        // Days in previous years
        for (int y = 1971; y < year; y++) {
            if (isLeapYear(y)) {
                totalDays += 366;
            } else {
                totalDays += 365;
            }
        }

        // Days in previous months
        if (isLeapYear(year)) {
            daysInMonth[1] = 29;
        }

        for (int m = 0; m < month - 1; m++) {
            totalDays += daysInMonth[m];
        }

        // Days before the given day
        totalDays += day - 1;

        // 1971-01-01 was Friday
        return week[(totalDays + 5) % 7];
    }

    private boolean isLeapYear(int year) {
        return year % 400 == 0 ||
               (year % 4 == 0 && year % 100 != 0);
    }
}
